#!/usr/bin/env python3
"""machine-state — read-only view of this Mac: load, memory, swap, processes.

Runs ps itself, so it works however it is typed; excluded from the Claude Code sandbox in
~/dotfiles/.claude/settings.json. Never prints a process's environment.

  machine-state                 load, memory, swap, top 15 by memory and by CPU
  machine-state --match TEXT    processes whose command line contains TEXT
  machine-state --pid N         one process and its children
  machine-state --top N         top N instead of 15
"""
import argparse, os, re, subprocess, sys


def ps_rows():
    # ps without -E/e: no environment. -ww: full command lines.
    out = subprocess.run(['ps', '-Ao', 'pid=,ppid=,pcpu=,rss=,etime=,command=', '-ww'],
                         capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        m = re.match(r'\s*(\d+)\s+(\d+)\s+([\d.]+)\s+(\d+)\s+(\S+)\s+(.*)', line)
        if m:
            pid, ppid, cpu, rss, et, cmd = m.groups()
            rows.append(dict(pid=int(pid), ppid=int(ppid), cpu=float(cpu), rss=int(rss), age=et, cmd=cmd))
    return rows


def show(rows, title):
    print(f'\n{title}')
    print(f'{"PID":>7} {"PPID":>7} {"CPU%":>6} {"MEM MB":>8} {"AGE":>12}  COMMAND')
    for r in rows:
        print(f'{r["pid"]:>7} {r["ppid"]:>7} {r["cpu"]:>6.1f} {r["rss"] / 1024:>8.0f} {r["age"]:>12}  {r["cmd"][:150]}')


def memory():
    vm = subprocess.run(['vm_stat'], capture_output=True, text=True).stdout
    page = int(re.search(r'page size of (\d+)', vm).group(1))
    get = lambda k: int(re.search(rf'{k}:\s+(\d+)', vm).group(1)) * page / 2**30
    swap = subprocess.run(['sysctl', '-n', 'vm.swapusage'], capture_output=True, text=True).stdout.strip()
    return (f'free {get("Pages free"):.1f} GB · compressor holds {get("Pages occupied by compressor"):.1f} GB'
            f' · swap {swap or "unreadable"}')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--match'); ap.add_argument('--pid', type=int); ap.add_argument('--top', type=int, default=15)
    a = ap.parse_args()
    rows = ps_rows()
    if a.match:
        show([r for r in rows if a.match in r['cmd'] and r['pid'] != os.getpid()], f'Processes matching {a.match!r}')
        return
    if a.pid:
        keep = {a.pid}
        for _ in range(10):
            keep |= {r['pid'] for r in rows if r['ppid'] in keep}
        show([r for r in rows if r['pid'] in keep], f'Process {a.pid} and its children')
        return
    print(f'load {os.getloadavg()[0]:.2f} {os.getloadavg()[1]:.2f} {os.getloadavg()[2]:.2f} on {os.cpu_count()} cores · {len(rows)} processes')
    print(memory())
    show(sorted(rows, key=lambda r: -r['rss'])[:a.top], f'Top {a.top} by memory')
    show(sorted(rows, key=lambda r: -r['cpu'])[:a.top], f'Top {a.top} by CPU')


if __name__ == '__main__':
    sys.exit(main())
