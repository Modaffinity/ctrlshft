#!/usr/bin/env python3
"""sandbox-doctor — does the Claude Code sandbox let this machine's pipeline work, and still guard what it must?

Run it from a pod (a git repo), inside a Claude session, at session start or in preflight.
Prints one PASS / FAIL line per check, and for each FAIL the fix. Exit 0 = all pass, 1 = a FAIL.
It never prints a secret and changes nothing it does not undo.
"""
import json, os, subprocess, sys, tempfile

HOME = os.path.expanduser('~')
SRC = f'{HOME}/dotfiles/.claude/settings.json'
LIVE = f'{HOME}/.claude/settings.json'
fails = 0


def report(ok, name, fix=''):
    global fails
    print(f'{"PASS" if ok else "FAIL"}  {name}' + ('' if ok else f'\n      fix: {fix}'))
    fails += not ok


def try_write(path, is_dir=False):
    try:
        if is_dir:
            d = tempfile.mkdtemp(prefix='sandbox-doctor-', dir=path); os.rmdir(d)
        else:
            with open(path, 'a'):
                pass
            os.remove(path)
        return True
    except OSError:
        return False


def deep_merge(a, b):  # what bootstrap.sh's `jq -s '.[0] * .[1]'` produces
    if isinstance(a, dict) and isinstance(b, dict):
        return {k: deep_merge(a[k], b[k]) if k in a and k in b else b.get(k, a.get(k)) for k in {**a, **b}}
    return b


src, live = json.load(open(SRC)), json.load(open(LIVE))
want = deep_merge(live, src)
for key in ('sandbox', 'permissions'):
    report(live.get(key) == want.get(key), f'live settings carry the dotfiles {key} section',
           'run in a terminal: bash ~/dotfiles/bin/bootstrap.sh (no Claude session may write ~/.claude)')

sb = live.get('sandbox', {})
excluded = set(sb.get('excludedCommands', []))
for pattern in ('git worktree *', '*/land-gate.sh *', '*/machine-state *', '*/reconcile_pod_skills.sh *',
                '*/relauncher.py *', '*/codex-run.sh *', 'node */codex-companion.mjs *'):
    report(pattern in excluded, f'excluded from the sandbox: {pattern}',
           f'add "{pattern}" to sandbox.excludedCommands in {SRC}, then bootstrap')
report(sb.get('filesystem', {}).get('allowGitConfig') is True, 'sandbox.filesystem.allowGitConfig is true',
       f'set it in {SRC}, then bootstrap')

# The pattern's presence is not enough (2026-10-26): the Codex plugin calls its companion with the path in
# quotes, `node "${CLAUDE_PLUGIN_ROOT}/scripts/codex-companion.mjs" task …`, which `node */codex-companion.mjs *`
# never matched — every plugin call stayed sandboxed and died on EPERM under ~/.claude/plugins/data (measured:
# quoted form EPERM, unquoted form ran). So take each invocation from the installed plugin's own files and
# match it, expanded, against the live patterns. fnmatch on the raw string is the reading the probe confirmed.
import fnmatch, glob, re
roots = sorted(glob.glob(f'{HOME}/.claude/plugins/cache/openai-codex/codex/*/'))
if roots:
    root = roots[-1].rstrip('/')
    forms = set()
    for doc in glob.glob(f'{root}/agents/*.md') + glob.glob(f'{root}/commands/*.md'):
        for m in re.finditer(r'node "\$\{CLAUDE_PLUGIN_ROOT\}/scripts/codex-companion\.mjs"[^`\n]*', open(doc).read()):
            forms.add(m.group(0).replace('${CLAUDE_PLUGIN_ROOT}', root).replace('"$ARGUMENTS"', '"x"')
                      .replace('$ARGUMENTS', 'x').replace('...', '--fresh x').rstrip(' .,`'))
    unmatched = sorted(f for f in forms if not any(fnmatch.fnmatchcase(f, p) for p in excluded))
    report(forms and not unmatched, f'every Codex plugin call runs outside the sandbox ({len(forms)} forms)',
           f'no excludedCommands pattern matches: {unmatched[:2]} — add a pattern for that form in {SRC}, then bootstrap')
else:
    print('SKIP  Codex plugin calls — the openai-codex plugin is not installed')

# Probes, run inside the sandbox exactly as a session's Bash would.
inside_repo = subprocess.run(['git', 'rev-parse', '--git-dir'], capture_output=True, text=True)
if inside_repo.returncode == 0:
    ok = subprocess.run(['git', 'config', '--local', 'sandboxdoctor.probe', '1'], capture_output=True).returncode == 0
    if ok:
        subprocess.run(['git', 'config', '--local', '--unset', 'sandboxdoctor.probe'], capture_output=True)
    # Known limit (measured 2026-10-21, Claude Code 2.1.307, macOS): .git/config.lock stays protected even with
    # allowGitConfig, in fresh sessions too. Branch deletion still succeeds (with a config warning); upstream
    # tracking is not written. Never fix this by excluding "git config *": core.hooksPath / core.fsmonitor would
    # let a session run commands outside the sandbox.
    print(f'{"PASS" if ok else "KNOWN"}  git can write .git/config'
          + ('' if ok else ' — protected by Claude Code on macOS; branch delete still works with a warning; do NOT exclude git config'))
    hooks = os.path.join(inside_repo.stdout.strip(), 'hooks', 'sandbox-doctor-probe')
    report(not try_write(hooks), 'CONTROL: .git/hooks stays write-protected', 'the sandbox must never allow this')
else:
    print('SKIP  git probes — not run from inside a git repository')

for path in (f'{HOME}/.cache', f'{HOME}/.npm', os.environ.get('TMPDIR', '/tmp')):
    report(try_write(path, is_dir=True), f'can write scratch under {path}', f'add {path} to filesystem.allowWrite, then bootstrap')

report(not try_write(f'{HOME}/.ssh/sandbox-doctor-probe'), 'CONTROL: ~/.ssh stays write-protected', 'the sandbox must never allow this')
try:
    os.listdir(f'{HOME}/dotfiles/secrets'); secrets_readable = True
except OSError:
    secrets_readable = False
report(not secrets_readable, 'CONTROL: ~/dotfiles/secrets stays unreadable', 'the sandbox must never allow this')

print(f'\n{"ALL PASS" if not fails else f"{fails} FAIL"} — sandbox-doctor')
sys.exit(1 if fails else 0)
